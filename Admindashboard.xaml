<Window x:Class="ServerStartupSuite.Admindashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServerStartupSuite"
        mc:Ignorable="d"
        Title="Admindashboard" Height="450" Width="800">
    <Grid Margin="30">
     
        <TextBlock Text="Administrator Dashboard"
                   FontSize="36"
                   FontWeight="ExtraBold"
                   Foreground="#891218"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30">
          
        </TextBlock>
        
        
        <UniformGrid Columns="2" Rows="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
            <Button x:Name="BtnUser" Content="User Management" Style="{StaticResource NmsuButtonStyle}" Margin="15" Click="BtnUser_Click"/>
            <Button x:Name="BtnSetup" Content="Base Workstation Setup" Style="{StaticResource NmsuButtonStyle}" Margin="15" Click="BtnSetup_Click"/>
            <Button x:Name="BtnNet" Content="System Summary" Style="{StaticResource NmsuButtonStyle}" Margin="15" Click="BtnNet_Click"/>
            <Button x:Name="BtnAdvanced" Content="Advanced" Style="{StaticResource NmsuButtonStyle}" Margin="15" Click="BtnAdvanced_Click"/>
        </UniformGrid>
    </Grid>
</Window>
