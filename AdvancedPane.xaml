<Window x:Class="ServerStartupSuite.AdvancedPane"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServerStartupSuite"
        mc:Ignorable="d"
        Title="Custom Script Deployment" Height="450" Width="800">
    <Grid Background="#F4F4F4">
        <StackPanel Width="280" VerticalAlignment="Center" HorizontalAlignment="Center">
            
            <TextBlock Text="Advanced Deployment"
                       FontSize="22" FontWeight="Bold" Foreground="#891218"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Name="txtSelectedPath"
                         IsReadOnly="True"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         BorderBrush="#891218"/>
                
                <Button Grid.Column="1"
                        Content="BROWSE"
                        Style="{StaticResource NmsuButtonStyle}"
                        Click="Browse_Click"
                        Width="80" Margin="5,0,0,0"/>
            </Grid>
            
            <Button Name="btnExecute"
                    Content="EXECUTE SCRIPT"
                    Style="{StaticResource NmsuButtonStyle}"
                    Click="RunScript_Click"
                    IsEnabled="True"
                    Margin="0,10,0,0"
                    Height="40"
                    FontWeight="Bold"
                    Background="#891218"
                    Foreground="AntiqueWhite"
                    BorderBrush="#891218"
                    BorderThickness="2"/>
            
            <Button Content="Return to Dashboard"
                    Click="Back_Click"
                    Background="Transparent"
                    Foreground="#891218"
                    BorderThickness="0"
                    FontSize="18"
                    Margin="0,20,0,0"
                    Cursor="Hand"/>
            
            <TextBlock Name="lblStatus"
                       Text="Select a .ps1 file to begin."
                       Foreground="#555"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap"/> 
        </StackPanel>
    </Grid>
</Window>