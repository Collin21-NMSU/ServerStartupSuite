<Window x:Class="ServerStartupSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServerStartupSuite"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#F4F4F4">
        <StackPanel Width="280" VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Admin Login" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Foreground="#891218" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <TextBox Name="txtUsername" Height="35" Margin="0,5" VerticalContentAlignment="Center"/>
            <PasswordBox Name="txtPassword" Height="35" Margin="0,5" VerticalContentAlignment="Center"/>

            <Button Name="btnlogin" 
                    Content="LOGIN" 
                    Style="{StaticResource NmsuButtonStyle}"
                    Margin="0,20,0,0" 
                    Click="btnLogin_Click"/>

            <TextBlock Name="lblStatus" 
                       Foreground="#891218" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>